{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "color": "#e51f2b", "name": "Primary" },
        { "slug": "secondary", "color": "#111827", "name": "Secondary" },
        { "slug": "accent", "color": "#f5b700", "name": "Accent" },
        { "slug": "surface", "color": "#f7f7f8", "name": "Surface" },
        { "slug": "white", "color": "#ffffff", "name": "White" },
        { "slug": "black", "color": "#111111", "name": "Black" }
      ],
      "gradients": []
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "small", "size": "1rem", "name": "Small" },
        { "slug": "medium", "size": "2rem", "name": "Medium" },
        { "slug": "large", "size": "4rem", "name": "Large" },
        { "slug": "x-large", "size": "6rem", "name": "Extra Large" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif", "slug": "body", "name": "System Sans" },
        { "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif", "slug": "heading", "name": "Heading Sans" }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "clamp(2.25rem, 5vw, 4.5rem)", "name": "Display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#111827"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "700", "lineHeight": "1.15" }
      },
      "button": {
        "border": { "radius": "4px" },
        "color": { "background": "var:preset|color|primary", "text": "#ffffff" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.5rem", "right": "1.5rem" } },
        "typography": { "fontWeight": "600" }
      }
    }
  }
}
